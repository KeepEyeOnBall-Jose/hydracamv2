{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cameraId": {
      "type": "string",
      "minLength": 1
    },
    "lens": {
      "type": "string",
      "enum": [
        "wide",
        "ultrawide",
        "tele"
      ]
    },
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "fps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "codec": {
      "type": "string",
      "enum": [
        "avc",
        "hevc"
      ]
    },
    "masterKbps": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "rotationDeg": {
      "type": "number",
      "enum": [
        0,
        90,
        180,
        270
      ]
    },
    "zoomRatio": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "stabilization": {
      "type": "boolean"
    },
    "aeLocked": {
      "type": "boolean"
    },
    "afLocked": {
      "type": "boolean"
    },
    "awbLocked": {
      "type": "boolean"
    },
    "exposureTimeNs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "iso": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "captureResult": {
      "type": "object",
      "properties": {
        "aeMode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "aeLock": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "afMode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "afState": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "awbMode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "awbLock": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "zoomRatio": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "videoStabilizationMode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "oisMode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "frameDurationNs": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "exposureTimeNs": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitivity": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "aeMode",
        "aeLock",
        "afMode",
        "afState",
        "awbMode",
        "awbLock",
        "zoomRatio",
        "videoStabilizationMode",
        "oisMode",
        "frameDurationNs",
        "exposureTimeNs",
        "sensitivity"
      ]
    }
  },
  "required": [
    "cameraId",
    "lens",
    "width",
    "height",
    "fps",
    "codec",
    "masterKbps",
    "rotationDeg",
    "zoomRatio",
    "stabilization",
    "aeLocked",
    "afLocked",
    "awbLocked"
  ]
}
