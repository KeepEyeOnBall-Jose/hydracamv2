{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "config.set"
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "required": [
        "rev",
        "values"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "body"
  ]
}
