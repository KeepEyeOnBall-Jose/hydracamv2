{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "preview.start"
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "publishUrl": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22,128}$"
        },
        "width": {
          "type": "number",
          "const": 640
        },
        "height": {
          "type": "number",
          "const": 360
        },
        "fps": {
          "type": "number",
          "const": 20
        },
        "kbps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "ttlS": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "publishUrl",
        "token",
        "width",
        "height",
        "fps",
        "kbps",
        "ttlS"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "body"
  ]
}
