{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "recording.gap"
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "tier": {
          "type": "string",
          "enum": [
            "proxy",
            "master"
          ]
        },
        "fromServerMs": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "enum": [
            "no-complete-frame"
          ]
        }
      },
      "required": [
        "sessionId",
        "tier",
        "fromServerMs",
        "reason"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "body"
  ]
}
