{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "recording.started"
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "firstFrameServerMs": {
          "type": "number",
          "minimum": 0
        },
        "offsetMs": {
          "type": "number"
        },
        "profile": {
          "type": "object",
          "properties": {
            "masterRes": {
              "type": "string",
              "enum": [
                "1080p",
                "720p"
              ]
            },
            "fps": {
              "type": "number",
              "enum": [
                30,
                60
              ]
            },
            "masterKbps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "proxyRes": {
              "type": "string",
              "const": "720p"
            },
            "proxyKbps": {
              "type": "number",
              "const": 2000
            },
            "segmentS": {
              "type": "number",
              "const": 6
            }
          },
          "required": [
            "masterRes",
            "fps",
            "masterKbps",
            "proxyRes",
            "proxyKbps",
            "segmentS"
          ]
        },
        "applied": {
          "type": "object",
          "properties": {
            "cameraId": {
              "type": "string",
              "minLength": 1
            },
            "lens": {
              "type": "string",
              "enum": [
                "wide",
                "ultrawide",
                "tele"
              ]
            },
            "width": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "fps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "codec": {
              "type": "string",
              "enum": [
                "avc",
                "hevc"
              ]
            },
            "masterKbps": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rotationDeg": {
              "type": "number",
              "enum": [
                0,
                90,
                180,
                270
              ]
            },
            "zoomRatio": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stabilization": {
              "type": "boolean"
            },
            "aeLocked": {
              "type": "boolean"
            },
            "afLocked": {
              "type": "boolean"
            },
            "awbLocked": {
              "type": "boolean"
            }
          },
          "required": [
            "cameraId",
            "lens",
            "width",
            "height",
            "fps",
            "codec",
            "masterKbps",
            "rotationDeg",
            "zoomRatio",
            "stabilization",
            "aeLocked",
            "afLocked",
            "awbLocked"
          ]
        }
      },
      "required": [
        "sessionId",
        "firstFrameServerMs",
        "offsetMs",
        "profile"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "body"
  ]
}
