{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "recording.stopped"
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1
        },
        "lastSeq": {
          "type": "object",
          "properties": {
            "proxy": {
              "type": "integer",
              "minimum": -1,
              "maximum": 9007199254740991
            },
            "master": {
              "type": "integer",
              "minimum": -1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "proxy",
            "master"
          ]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "sessionId",
        "lastSeq",
        "reason"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "body"
  ]
}
