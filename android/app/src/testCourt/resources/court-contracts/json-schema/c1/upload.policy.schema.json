{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "const": "upload.policy"
    },
    "ts": {
      "type": "number",
      "minimum": 0
    },
    "body": {
      "type": "object",
      "properties": {
        "masterMode": {
          "type": "string",
          "enum": [
            "never",
            "on-request",
            "window",
            "stream"
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxKbps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "keepDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "masterMaxKbps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "masterMode",
        "windows",
        "maxKbps",
        "keepDays"
      ]
    }
  },
  "required": [
    "v",
    "id",
    "type",
    "ts",
    "body"
  ]
}
