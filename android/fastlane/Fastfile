require "digest"
require "fileutils"
require "shellwords"

default_platform(:android)

REPO_ROOT = File.expand_path("../..", __dir__)
AAB_PATH = File.join(
  REPO_ROOT,
  "build/app/outputs/bundle/release/app-release.aab"
)
STORE_METADATA_FORMAT = "HydraCamStoreArtifactMetadataV1"

def flutter_bin
  ENV["FLUTTER_BIN"] || "flutter"
end

def flutter_build_flags
  flags = []
  flags += ["--build-name", ENV["BUILD_NAME"]] unless ENV["BUILD_NAME"].to_s.empty?
  flags += ["--build-number", ENV["BUILD_NUMBER"]] unless ENV["BUILD_NUMBER"].to_s.empty?
  unless ENV["HYDRACAM_PRIVACY_POLICY_URL"].to_s.empty?
    flags += [
      "--dart-define",
      "HYDRACAM_PRIVACY_POLICY_URL=#{ENV["HYDRACAM_PRIVACY_POLICY_URL"]}"
    ]
  end
  unless ENV["HYDRACAM_SUPPORT_URL"].to_s.empty?
    flags += [
      "--dart-define",
      "HYDRACAM_SUPPORT_URL=#{ENV["HYDRACAM_SUPPORT_URL"]}"
    ]
  end
  unless ENV["HYDRACAM_ACCOUNT_DELETION_URL"].to_s.empty?
    flags += [
      "--dart-define",
      "HYDRACAM_ACCOUNT_DELETION_URL=#{ENV["HYDRACAM_ACCOUNT_DELETION_URL"]}"
    ]
  end
  flags
end

def write_store_metadata(artifact_path, platform, builder)
  UI.user_error!("Expected artifact missing or empty: #{artifact_path}") unless File.size?(artifact_path)

  metadata_path = "#{artifact_path}.store-metadata.tsv"
  metadata = {
    "format" => STORE_METADATA_FORMAT,
    "platform" => platform,
    "artifact_path" => artifact_path,
    "artifact_sha256" => Digest::SHA256.file(artifact_path).hexdigest,
    "builder" => builder,
    "built_at_utc" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "build_name" => ENV["BUILD_NAME"].to_s,
    "build_number" => ENV["BUILD_NUMBER"].to_s,
    "hydracam_privacy_policy_url" => ENV["HYDRACAM_PRIVACY_POLICY_URL"].to_s,
    "hydracam_support_url" => ENV["HYDRACAM_SUPPORT_URL"].to_s,
    "hydracam_account_deletion_url" => ENV["HYDRACAM_ACCOUNT_DELETION_URL"].to_s
  }

  File.open(metadata_path, "w") do |file|
    metadata.each do |key, value|
      file.puts("#{key}\t#{value}")
    end
  end

  UI.message("Wrote store metadata: #{metadata_path}")
end

def build_release_aab
  FileUtils.rm_f(AAB_PATH)
  FileUtils.rm_f("#{AAB_PATH}.store-metadata.tsv")

  command = [
    flutter_bin,
    "build",
    "appbundle",
    "--release"
  ] + flutter_build_flags

  sh("cd #{Shellwords.escape(REPO_ROOT)} && #{Shellwords.join(command)}")
  write_store_metadata(AAB_PATH, "android", "android/fastlane")
end

def play_upload_options(track)
  options = {
    track: track,
    aab: AAB_PATH,
    skip_upload_metadata: true,
    skip_upload_changelogs: false,
    skip_upload_images: true,
    skip_upload_screenshots: true
  }

  json_key = ENV["GOOGLE_PLAY_JSON_KEY"]
  options[:json_key] = json_key unless json_key.to_s.empty?

  options
end

platform :android do
  desc "Build the release Android App Bundle"
  lane :build_store do
    build_release_aab
  end

  desc "Upload a build to Google Play Internal testing"
  lane :internal do
    build_release_aab
    upload_to_play_store(
      play_upload_options("internal").merge(
        release_status: "completed"
      )
    )
  end

  desc "Upload a build to a Google Play closed testing track"
  lane :closed_beta do
    build_release_aab
    track = ENV["PLAY_CLOSED_TRACK"].to_s.empty? ? "beta" : ENV["PLAY_CLOSED_TRACK"]
    upload_to_play_store(
      play_upload_options(track).merge(
        release_status: "completed"
      )
    )
  end

  desc "Upload a production draft to Google Play"
  lane :production_draft do
    build_release_aab
    upload_to_play_store(
      play_upload_options("production").merge(
        release_status: "draft"
      )
    )
  end
end
