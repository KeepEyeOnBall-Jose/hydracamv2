# HydraCam lab/store environment constants (example).
#
# Copy this file to config/lab.env and fill in real values for your lab.
# config/lab.env is git-ignored; this .example file is committed intentionally
# so the constants below are documented in one place instead of scattered
# across scripts and runbooks.
#
# scripts/hydracam_lib/labconfig.py loads config/lab.env if present. Real
# environment variables always override values from the file, and every key
# falls back to the same hard-coded default already used today, so nothing
# breaks if this file is absent. This file is CONSULTATIVE ONLY right now:
# no existing script reads it yet (migration happens in a later phase); it
# exists so the constants have one documented home ahead of that migration.

# --- Automation bridge -------------------------------------------------
# HTTP port the in-app automation bridge listens on (per device).
# Used by: scripts/ios_capture_repro.py (DEFAULT_PORT), scripts/run_hardware_ui_e2e.py
# (REMOTE_AUTOMATION_PORT), scripts/run_parallel_device_matrix.py
# (REMOTE_AUTOMATION_PORT), scripts/multi_device_orchestrator.py
# (AUTOMATION_REMOTE_PORT), scripts/hybrid_deploy.sh (BRIDGE_PORT_DEVICE);
# AUTOMATION_RUNBOOK.md section 7.
HYDRACAM_BRIDGE_PORT=4762

# Example/known lab bridge host (an iPad automation bridge seen repeatedly in
# fleet evidence; treat as a placeholder to copy-paste for --ios-host /
# --expected-host flags, not a live guarantee).
# Used by: scripts/test_run_rotating_master_slave_matrix.py,
# docs/control/status-and-roadmap.md, docs/control/hybrid-deploy-plan.md.
HYDRACAM_LAB_BRIDGE_HOST=192.168.178.104

# Expected HydraCam LAN subnet used for Wi-Fi preflight and scan defaults.
# Used by: scripts/android_wifi_preflight.py (--expected-subnet help text),
# scripts/ios_capture_repro.py (DEFAULT_SCAN_SUBNET),
# docs/control/regular-evaluation-plan.md, docs/control/fleet-operations-plan.md,
# docs/control/local-ide-emulator-deploy-playbook.md.
HYDRACAM_LAB_SUBNET=192.168.178.0/24

# Example device-under-test IP used in wired ADB test fixtures (wireless ADB
# endpoint, port 5555 is the standard adb-over-tcp port).
# Used by: scripts/test_android_screen_brightness.py.
HYDRACAM_LAB_DEVICE_IP=192.168.178.64

# --- Media timeline bridge ----------------------------------------------
# Example local media-timeline API base URL used in single-device capture
# profile test fixtures. Port 3001 is the media-timeline dev server's default.
# Used by: scripts/test_run_android_capture_profile.py,
# scripts/test_run_hardware_ui_e2e.py (HYDRACAM_MEDIA_TIMELINE_API_BASE_URL).
HYDRACAM_MEDIA_TIMELINE_API_BASE_URL=http://192.168.1.20:3001/api

# --- FTP video pull (Android device -> Mac) ------------------------------
# Default FTP port used when uploading captured videos off an Android device.
# Used by: scripts/attic/upload_videos_ftp.py (ftp_port default, archived
# one-off), scripts/android_ftp_upload.sh (FTP_PORT default). The FTP host
# itself is always passed as a CLI arg (there is no hard-coded default host)
# — 192.168.1.100 appears only in the scripts' own --help/usage examples.
HYDRACAM_FTP_PORT=2121

# --- Store URLs -----------------------------------------------------------
# Public store-facing pages (privacy policy, support, account deletion).
# store-site-ten.vercel.app is the current live Vercel deployment host;
# store.hydracam.app is the target/staging custom domain used in store
# readiness tests.
# Used by: scripts/testflight_release_and_invite.sh, scripts/google_play_release.sh
# (HYDRACAM_PRIVACY_POLICY_URL / HYDRACAM_SUPPORT_URL /
# HYDRACAM_ACCOUNT_DELETION_URL defaults), scripts/test_store_readiness_mode_scope.py,
# docs/control/store-privacy-and-metadata.md.
HYDRACAM_PRIVACY_POLICY_URL=https://store-site-ten.vercel.app/privacy.html
HYDRACAM_SUPPORT_URL=https://store-site-ten.vercel.app/support.html
HYDRACAM_ACCOUNT_DELETION_URL=https://store-site-ten.vercel.app/account-deletion.html

# Alternate/custom-domain store URLs exercised by store readiness tests.
# Used by: scripts/test_store_readiness_mode_scope.py.
HYDRACAM_STORE_DOMAIN_PRIVACY_POLICY_URL=https://store.hydracam.app/privacy
HYDRACAM_STORE_DOMAIN_SUPPORT_URL=https://store.hydracam.app/support
HYDRACAM_STORE_DOMAIN_ACCOUNT_DELETION_URL=https://store.hydracam.app/account-deletion
