require "digest"
require "fileutils"
require "shellwords"

default_platform(:ios)

REPO_ROOT = File.expand_path("../..", __dir__)
IPA_GLOB = File.join(REPO_ROOT, "build/ios/ipa/*.ipa")
STORE_METADATA_FORMAT = "HydraCamStoreArtifactMetadataV1"

def flutter_bin
  ENV["FLUTTER_BIN"] || "flutter"
end

def flutter_build_flags
  flags = []
  flags += ["--build-name", ENV["BUILD_NAME"]] unless ENV["BUILD_NAME"].to_s.empty?
  flags += ["--build-number", ENV["BUILD_NUMBER"]] unless ENV["BUILD_NUMBER"].to_s.empty?
  unless ENV["HYDRACAM_PRIVACY_POLICY_URL"].to_s.empty?
    flags += [
      "--dart-define",
      "HYDRACAM_PRIVACY_POLICY_URL=#{ENV["HYDRACAM_PRIVACY_POLICY_URL"]}"
    ]
  end
  unless ENV["HYDRACAM_SUPPORT_URL"].to_s.empty?
    flags += [
      "--dart-define",
      "HYDRACAM_SUPPORT_URL=#{ENV["HYDRACAM_SUPPORT_URL"]}"
    ]
  end
  unless ENV["HYDRACAM_ACCOUNT_DELETION_URL"].to_s.empty?
    flags += [
      "--dart-define",
      "HYDRACAM_ACCOUNT_DELETION_URL=#{ENV["HYDRACAM_ACCOUNT_DELETION_URL"]}"
    ]
  end
  flags
end

def write_store_metadata(artifact_path, platform, builder)
  UI.user_error!("Expected artifact missing or empty: #{artifact_path}") unless File.size?(artifact_path)

  metadata_path = "#{artifact_path}.store-metadata.tsv"
  metadata = {
    "format" => STORE_METADATA_FORMAT,
    "platform" => platform,
    "artifact_path" => artifact_path,
    "artifact_sha256" => Digest::SHA256.file(artifact_path).hexdigest,
    "builder" => builder,
    "built_at_utc" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ"),
    "build_name" => ENV["BUILD_NAME"].to_s,
    "build_number" => ENV["BUILD_NUMBER"].to_s,
    "hydracam_privacy_policy_url" => ENV["HYDRACAM_PRIVACY_POLICY_URL"].to_s,
    "hydracam_support_url" => ENV["HYDRACAM_SUPPORT_URL"].to_s,
    "hydracam_account_deletion_url" => ENV["HYDRACAM_ACCOUNT_DELETION_URL"].to_s
  }

  File.open(metadata_path, "w") do |file|
    metadata.each do |key, value|
      file.puts("#{key}\t#{value}")
    end
  end

  UI.message("Wrote store metadata: #{metadata_path}")
end

def build_release_ipa
  sh("cd #{Shellwords.escape(REPO_ROOT)} && SKIP_CHECKS=1 bash scripts/build_store_artifacts.sh ios")
end

def latest_ipa
  ipa = Dir[IPA_GLOB].max_by { |path| File.mtime(path) }
  UI.user_error!("No IPA found in #{IPA_GLOB}") unless ipa
  ipa
end

def app_store_connect_options
  api_key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]
  return { api_key_path: api_key_path } if File.file?(api_key_path.to_s)

  key_filepath = ENV["APP_STORE_CONNECT_API_KEY_P8_PATH"].to_s.empty? ?
    ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"] :
    ENV["APP_STORE_CONNECT_API_KEY_P8_PATH"]
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.empty? ?
    ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] :
    ENV["APP_STORE_CONNECT_API_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"].to_s.empty? ?
    ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] :
    ENV["APP_STORE_CONNECT_API_ISSUER_ID"]

  return {} unless File.file?(key_filepath.to_s) && !key_id.to_s.empty? && !issuer_id.to_s.empty?

  {
    api_key: app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      duration: 1200,
      in_house: false
    )
  }
end

def testflight_groups
  ENV["TESTFLIGHT_GROUPS"].to_s
    .split(",")
    .map(&:strip)
    .reject(&:empty?)
end

def testflight_upload_options(ipa_path)
  options = app_store_connect_options.merge(
    ipa: ipa_path,
    changelog: ENV["TESTFLIGHT_CHANGELOG"],
    skip_waiting_for_build_processing: false
  )

  if ENV["TESTFLIGHT_DISTRIBUTE_EXTERNAL"] == "true"
    options[:distribute_external] = true
    groups = testflight_groups
    options[:groups] = groups unless groups.empty?
  end

  options
end

platform :ios do
  desc "Build the release IPA for App Store Connect"
  lane :build_store do
    build_release_ipa
  end

  desc "Upload a new beta build to TestFlight"
  lane :beta do
    build_release_ipa

    upload_to_testflight(testflight_upload_options(latest_ipa))
  end

  desc "Upload the latest local IPA to TestFlight without rebuilding"
  lane :upload_latest_beta do
    upload_to_testflight(testflight_upload_options(latest_ipa))
  end

  desc "Build an icon-launchable Profile app for physical iPhone development"
  lane :device do
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Profile",
      sdk: "iphoneos",
      destination: "generic/platform=iOS",
      export_method: "development",
      skip_package_ipa: true
    )
  end
end
