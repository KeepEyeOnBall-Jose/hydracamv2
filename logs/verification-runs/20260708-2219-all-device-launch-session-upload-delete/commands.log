import urllib.request, concurrent.futures
hosts=[f"192.168.178.{i}" for i in range(1,255)]
def probe(h):
    try:
        with urllib.request.urlopen(f"http://{h}:4762/healthz", timeout=0.4) as r:
            return h, r.read(500).decode("utf-8", "replace")
    except Exception:
        return None
with concurrent.futures.ThreadPoolExecutor(max_workers=64) as ex:
    for res in ex.map(probe, hosts):
        if res:
            print(res[0], res[1])
